@page "/catalog"
@rendermode InteractiveServer

@inject ICreateArticleGroupUseCase CreateArticleGroupUseCase
@inject ISearchArticleGroupsUseCase SearchArticleGroupsUseCase
@inject IGetArticleGroupForEditUseCase GetArticleGroupForEditUseCase
@inject IRenameArticleGroupUseCase RenameArticleGroupUseCase
@inject IDeleteArticleGroupUseCase DeleteArticleGroupUseCase
@inject ICreateArticleUseCase CreateArticleUseCase
@inject ISearchArticlesUseCase SearchArticlesUseCase
@inject IGetArticleForEditUseCase GetArticleForEditUseCase
@inject IUpdateArticleUseCase UpdateArticleUseCase
@inject IDeleteArticleUseCase DeleteArticleUseCase

<PageTitle>Catalog</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Catalog management</p>
        <h1>Catalog</h1>
        <p class="page-subtitle">Manage article groups and articles. Create groups first, then assign articles to them.</p>
    </div>
    @if (_activeTab == "groups")
    {
        <button class="btn btn-primary" @onclick="StartCreateGroup">New group</button>
    }
    else
    {
        <button class="btn btn-primary" @onclick="StartCreateArticle">New article</button>
    }
</div>

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <button class="nav-link @(_activeTab == "groups" ? "active" : string.Empty)" @onclick='() => _activeTab = "groups"'>
            Article Groups
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(_activeTab == "articles" ? "active" : string.Empty)" @onclick="SwitchToArticlesAsync">
            Articles
        </button>
    </li>
</ul>

@if (_activeTab == "groups")
{
    @if (_groupMessage is not null)
    {
        <div class="alert alert-success">@_groupMessage</div>
    }
    @if (_groupError is not null)
    {
        <div class="alert alert-danger">@_groupError</div>
    }

    <section class="content-grid customer-management-grid">
        <article class="card-panel customer-form-panel">
            <div class="section-title">
                <div>
                    <p class="eyebrow">@(_isGroupEditMode ? "Edit" : "Create")</p>
                    <h2>@(_isGroupEditMode ? "Edit group" : "Create group")</h2>
                </div>
                @if (_isGroupEditMode)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="StartCreateGroup">Cancel edit</button>
                }
            </div>

            <EditForm Model="_groupForm" OnValidSubmit="SaveGroupAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-grid">
                    <div class="form-field form-field-wide">
                        <label>Name</label>
                        <InputText class="form-control" @bind-Value="_groupForm.Name" />
                    </div>

                    <div class="form-field form-field-wide">
                        <label>Parent group <small class="text-muted">(optional — leave empty for a root group)</small></label>
                        <InputSelect class="form-select" @bind-Value="_groupForm.ParentGroupId">
                            <option value="0">— none (root group) —</option>
                            @foreach (ArticleGroupListItemDto g in _availableParents)
                            {
                                <option value="@g.ArticleGroupId">@g.Name</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="form-actions">
                    <button class="btn btn-primary" type="submit" disabled="@_isGroupBusy">
                        @(_isGroupBusy ? "Saving..." : _isGroupEditMode ? "Save changes" : "Create group")
                    </button>
                </div>
            </EditForm>
        </article>

        <article class="card-panel customer-list-panel">
            <div class="section-title">
                <div>
                    <p class="eyebrow">Overview</p>
                    <h2>Group list</h2>
                </div>
            </div>

            <div class="search-row">
                <InputText class="form-control" placeholder="Search by name" @bind-Value="_groupSearchTerm" />
                <button class="btn btn-outline-primary" @onclick="LoadGroupsAsync" disabled="@_isGroupBusy">Search</button>
            </div>

            @if (_groups.Count == 0)
            {
                <div class="empty-state">
                    <strong>No groups found.</strong>
                    <span>Create the first article group or adjust the search.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table customer-table align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Parent group</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ArticleGroupListItemDto group in _groups)
                            {
                                <tr>
                                    <td>@group.Name</td>
                                    <td>@(group.ParentGroupName ?? "—")</td>
                                    <td class="table-actions">
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadGroupForEditAsync(group.ArticleGroupId)" @onclick:stopPropagation="true">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteGroupAsync(group.ArticleGroupId, group.Name)" @onclick:stopPropagation="true">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </section>
}
else
{
    @if (_articleMessage is not null)
    {
        <div class="alert alert-success">@_articleMessage</div>
    }
    @if (_articleError is not null)
    {
        <div class="alert alert-danger">@_articleError</div>
    }

    <section class="content-grid customer-management-grid">
        <article class="card-panel customer-form-panel">
            <div class="section-title">
                <div>
                    <p class="eyebrow">@(_isArticleEditMode ? "Edit" : "Create")</p>
                    <h2>@(_isArticleEditMode ? "Edit article" : "Create article")</h2>
                </div>
                @if (_isArticleEditMode)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="StartCreateArticle">Cancel edit</button>
                }
            </div>

            <EditForm Model="_articleForm" OnValidSubmit="SaveArticleAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-grid">
                    <div class="form-field">
                        <label>Article number</label>
                        <InputText class="form-control" @bind-Value="_articleForm.ArticleNumber" disabled="@_isArticleEditMode" />
                        <small>Max 20 characters, e.g. ART-001</small>
                    </div>

                    <div class="form-field">
                        <label>Name</label>
                        <InputText class="form-control" @bind-Value="_articleForm.Name" />
                    </div>

                    <div class="form-field">
                        <label>Price</label>
                        <InputNumber class="form-control" @bind-Value="_articleForm.PriceAmount" />
                    </div>

                    <div class="form-field">
                        <label>Currency</label>
                        <InputText class="form-control" @bind-Value="_articleForm.PriceCurrency" />
                        <small>3-letter code, e.g. CHF</small>
                    </div>

                    <div class="form-field">
                        <label>Article group</label>
                        @if (_groups.Count == 0)
                        {
                            <div class="alert alert-warning py-1 px-2 mb-0">
                                No groups exist yet.
                                <button type="button" class="btn btn-link p-0 align-baseline" @onclick='() => _activeTab = "groups"'>Create a group first.</button>
                            </div>
                        }
                        else
                        {
                            <InputSelect class="form-select" @bind-Value="_articleForm.GroupId">
                                <option value="0">— select group —</option>
                                @foreach (ArticleGroupListItemDto g in _groups)
                                {
                                    <option value="@g.ArticleGroupId">@g.Name</option>
                                }
                            </InputSelect>
                        }
                    </div>

                    <div class="form-field">
                        <label>Stock</label>
                        <InputNumber class="form-control" @bind-Value="_articleForm.Stock" />
                    </div>

                    <div class="form-field">
                        <label>VAT rate (%)</label>
                        <InputNumber class="form-control" @bind-Value="_articleForm.VatRate" />
                    </div>

                    <div class="form-field form-field-wide">
                        <label>Description</label>
                        <InputText class="form-control" @bind-Value="_articleForm.Description" />
                    </div>
                </div>

                <div class="form-actions">
                    <button class="btn btn-primary" type="submit" disabled="@_isArticleBusy">
                        @(_isArticleBusy ? "Saving..." : _isArticleEditMode ? "Save changes" : "Create article")
                    </button>
                </div>
            </EditForm>
        </article>

        <article class="card-panel customer-list-panel">
            <div class="section-title">
                <div>
                    <p class="eyebrow">Overview</p>
                    <h2>Article list</h2>
                </div>
            </div>

            <div class="search-row">
                <InputText class="form-control" placeholder="Search by number or name" @bind-Value="_articleSearchTerm" />
                <button class="btn btn-outline-primary" @onclick="LoadArticlesAsync" disabled="@_isArticleBusy">Search</button>
            </div>

            @if (_articles.Count == 0)
            {
                <div class="empty-state">
                    <strong>No articles found.</strong>
                    <span>Create the first article or adjust the search.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table customer-table align-middle">
                        <thead>
                            <tr>
                                <th>Number</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Group</th>
                                <th>Stock</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ArticleListItemDto article in _articles)
                            {
                                <tr>
                                    <td><span class="badge-soft">@article.ArticleNumber</span></td>
                                    <td>@article.Name</td>
                                    <td>@article.PriceAmount.ToString("N2") @article.PriceCurrency</td>
                                    <td>@article.GroupName</td>
                                    <td>@article.Stock</td>
                                    <td class="table-actions">
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadArticleForEditAsync(article.ArticleId)" @onclick:stopPropagation="true">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteArticleAsync(article.ArticleId)" @onclick:stopPropagation="true">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </section>
}

@code {
    // ── Tab ───────────────────────────────────────────────────────────────────
    private string _activeTab = "groups";

    // ── Shared state (groups list drives the article form dropdown) ───────────
    private readonly List<ArticleGroupListItemDto> _groups = [];
    private readonly List<ArticleGroupListItemDto> _availableParents = [];

    // ── Group state ───────────────────────────────────────────────────────────
    private readonly ArticleGroupFormModel _groupForm = new();
    private string? _groupSearchTerm;
    private string? _groupMessage;
    private string? _groupError;
    private bool _isGroupBusy;
    private bool _isGroupEditMode;

    // ── Article state ─────────────────────────────────────────────────────────
    private readonly ArticleFormModel _articleForm = new();
    private readonly List<ArticleListItemDto> _articles = [];
    private string? _articleSearchTerm;
    private string? _articleMessage;
    private string? _articleError;
    private bool _isArticleBusy;
    private bool _isArticleEditMode;
    private bool _articlesLoaded;

    protected override async Task OnInitializedAsync()
    {
        await LoadGroupsAsync();
    }

    // ── Tab switching ─────────────────────────────────────────────────────────
    private async Task SwitchToArticlesAsync()
    {
        _activeTab = "articles";
        if (!_articlesLoaded)
        {
            await LoadArticlesAsync();
        }
    }

    // ── Group actions ─────────────────────────────────────────────────────────
    private void StartCreateGroup()
    {
        _isGroupEditMode = false;
        _groupMessage = null;
        _groupError = null;
        _groupForm.Reset();
        RefreshAvailableParents();
    }

    private async Task LoadGroupsAsync()
    {
        _isGroupBusy = true;
        _groupError = null;

        var result = await SearchArticleGroupsUseCase.ExecuteAsync(new SearchArticleGroupsQuery(_groupSearchTerm, null));

        _groups.Clear();

        if (!result.IsSuccess)
        {
            _groupError = result.Error;
            _isGroupBusy = false;
            return;
        }

        _groups.AddRange(result.Value!);
        RefreshAvailableParents();
        _isGroupBusy = false;
    }

    private void RefreshAvailableParents()
    {
        _availableParents.Clear();
        _availableParents.AddRange(_groups.Where(g => g.ArticleGroupId != _groupForm.ArticleGroupId));
    }

    private async Task SaveGroupAsync()
    {
        _isGroupBusy = true;
        _groupMessage = null;
        _groupError = null;

        if (_isGroupEditMode)
        {
            var command = new RenameArticleGroupCommand(_groupForm.ArticleGroupId, _groupForm.Name);
            var result = await RenameArticleGroupUseCase.ExecuteAsync(command);

            if (!result.IsSuccess)
            {
                _groupError = result.Error;
                _isGroupBusy = false;
                return;
            }

            _groupMessage = "Group was renamed.";
        }
        else
        {
            int? parentId = _groupForm.ParentGroupId == 0 ? null : _groupForm.ParentGroupId;
            var command = new CreateArticleGroupCommand(_groupForm.Name, parentId);
            var result = await CreateArticleGroupUseCase.ExecuteAsync(command);

            if (!result.IsSuccess)
            {
                _groupError = result.Error;
                _isGroupBusy = false;
                return;
            }

            _groupMessage = $"Group '{result.Value!.Name}' was created.";
            _groupForm.Reset();
        }

        await LoadGroupsAsync();

        if (_articlesLoaded)
        {
            await LoadArticlesAsync();
        }

        _isGroupBusy = false;
    }

    private async Task LoadGroupForEditAsync(int groupId)
    {
        _isGroupBusy = true;
        _groupMessage = null;
        _groupError = null;

        var result = await GetArticleGroupForEditUseCase.ExecuteAsync(new GetArticleGroupForEditQuery(groupId));

        if (!result.IsSuccess)
        {
            _groupError = result.Error;
            _isGroupBusy = false;
            return;
        }

        GetArticleGroupForEditResponse group = result.Value!;

        _groupForm.ArticleGroupId = group.ArticleGroupId;
        _groupForm.Name = group.Name;
        _groupForm.ParentGroupId = group.ParentGroupId ?? 0;

        _isGroupEditMode = true;
        RefreshAvailableParents();
        _isGroupBusy = false;
    }

    private async Task DeleteGroupAsync(int groupId, string groupName)
    {
        _isGroupBusy = true;
        _groupMessage = null;
        _groupError = null;

        var result = await DeleteArticleGroupUseCase.ExecuteAsync(new DeleteArticleGroupCommand(groupId));

        if (!result.IsSuccess)
        {
            _groupError = result.Error;
            _isGroupBusy = false;
            return;
        }

        if (_isGroupEditMode && _groupForm.ArticleGroupId == groupId)
        {
            StartCreateGroup();
        }

        _groupMessage = $"Group '{groupName}' was deleted.";
        await LoadGroupsAsync();

        if (_articlesLoaded)
        {
            await LoadArticlesAsync();
        }

        _isGroupBusy = false;
    }

    // ── Article actions ───────────────────────────────────────────────────────
    private void StartCreateArticle()
    {
        _isArticleEditMode = false;
        _articleMessage = null;
        _articleError = null;
        _articleForm.Reset();
    }

    private async Task LoadArticlesAsync()
    {
        _isArticleBusy = true;
        _articleError = null;

        var result = await SearchArticlesUseCase.ExecuteAsync(new SearchArticlesQuery(_articleSearchTerm, null));

        _articles.Clear();

        if (!result.IsSuccess)
        {
            _articleError = result.Error;
            _isArticleBusy = false;
            return;
        }

        _articles.AddRange(result.Value!);
        _articlesLoaded = true;
        _isArticleBusy = false;
    }

    private async Task SaveArticleAsync()
    {
        _isArticleBusy = true;
        _articleMessage = null;
        _articleError = null;

        if (_isArticleEditMode)
        {
            var command = new UpdateArticleCommand(
                _articleForm.ArticleId,
                _articleForm.Name,
                _articleForm.PriceAmount,
                _articleForm.PriceCurrency,
                _articleForm.GroupId,
                _articleForm.Stock,
                _articleForm.VatRate,
                _articleForm.Description);

            var result = await UpdateArticleUseCase.ExecuteAsync(command);

            if (!result.IsSuccess)
            {
                _articleError = result.Error;
                _isArticleBusy = false;
                return;
            }

            _articleMessage = "Article was updated.";
        }
        else
        {
            var command = new CreateArticleCommand(
                _articleForm.ArticleNumber,
                _articleForm.Name,
                _articleForm.PriceAmount,
                _articleForm.PriceCurrency,
                _articleForm.GroupId,
                _articleForm.Stock,
                _articleForm.VatRate,
                _articleForm.Description);

            var result = await CreateArticleUseCase.ExecuteAsync(command);

            if (!result.IsSuccess)
            {
                _articleError = result.Error;
                _isArticleBusy = false;
                return;
            }

            _articleMessage = $"Article {result.Value!.ArticleNumber} was created.";
            _articleForm.Reset();
        }

        await LoadArticlesAsync();
        _isArticleBusy = false;
    }

    private async Task LoadArticleForEditAsync(int articleId)
    {
        _isArticleBusy = true;
        _articleMessage = null;
        _articleError = null;

        var result = await GetArticleForEditUseCase.ExecuteAsync(new GetArticleForEditQuery(articleId));

        if (!result.IsSuccess)
        {
            _articleError = result.Error;
            _isArticleBusy = false;
            return;
        }

        GetArticleForEditResponse article = result.Value!;

        _articleForm.ArticleId = article.ArticleId;
        _articleForm.ArticleNumber = article.ArticleNumber;
        _articleForm.Name = article.Name;
        _articleForm.PriceAmount = article.PriceAmount;
        _articleForm.PriceCurrency = article.PriceCurrency;
        _articleForm.GroupId = article.GroupId;
        _articleForm.Stock = article.Stock;
        _articleForm.VatRate = article.VatRate;
        _articleForm.Description = article.Description;

        _isArticleEditMode = true;
        _isArticleBusy = false;
    }

    private async Task DeleteArticleAsync(int articleId)
    {
        _isArticleBusy = true;
        _articleMessage = null;
        _articleError = null;

        var result = await DeleteArticleUseCase.ExecuteAsync(new DeleteArticleCommand(articleId));

        if (!result.IsSuccess)
        {
            _articleError = result.Error;
            _isArticleBusy = false;
            return;
        }

        if (_isArticleEditMode && _articleForm.ArticleId == articleId)
        {
            StartCreateArticle();
        }

        _articleMessage = "Article was deleted.";
        await LoadArticlesAsync();
        _isArticleBusy = false;
    }

    // ── Form models ───────────────────────────────────────────────────────────
    private sealed class ArticleGroupFormModel
    {
        public int ArticleGroupId { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(150, ErrorMessage = "Name must not exceed 150 characters.")]
        public string Name { get; set; } = string.Empty;

        public int ParentGroupId { get; set; }

        public void Reset()
        {
            ArticleGroupId = 0;
            Name = string.Empty;
            ParentGroupId = 0;
        }
    }

    private sealed class ArticleFormModel
    {
        public int ArticleId { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string ArticleNumber { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.Range(0, double.MaxValue, ErrorMessage = "Price must be 0 or greater.")]
        public decimal PriceAmount { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(3, MinimumLength = 3, ErrorMessage = "Currency must be a 3-letter code.")]
        public string PriceCurrency { get; set; } = "CHF";

        [System.ComponentModel.DataAnnotations.Range(1, int.MaxValue, ErrorMessage = "Please select an article group.")]
        public int GroupId { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0, int.MaxValue, ErrorMessage = "Stock cannot be negative.")]
        public int Stock { get; set; }

        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0", "999.99", ErrorMessage = "VAT rate must be between 0 and 999.99.")]
        public decimal VatRate { get; set; }

        public string? Description { get; set; }

        public void Reset()
        {
            ArticleId = 0;
            ArticleNumber = string.Empty;
            Name = string.Empty;
            PriceAmount = 0;
            PriceCurrency = "CHF";
            GroupId = 0;
            Stock = 0;
            VatRate = 0;
            Description = null;
        }
    }
}
