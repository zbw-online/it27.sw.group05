@page "/customers"
@rendermode InteractiveServer

@inject ISearchCustomersUseCase SearchCustomersUseCase
@inject ICreateCustomerUseCase CreateCustomerUseCase
@inject IGetCustomerForEditUseCase GetCustomerForEditUseCase
@inject IUpdateCustomerUseCase UpdateCustomerUseCase
@inject IDeleteCustomerUseCase DeleteCustomerUseCase
@inject IGetCustomerDetailsUseCase GetCustomerDetailsUseCase
@inject IAddCustomerAddressUseCase AddCustomerAddressUseCase

<PageTitle>Customers</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Customer management</p>
        <h1>Customers</h1>
        <p class="page-subtitle">Search, create, update and delete customers through Application Layer use cases.</p>
    </div>
    <button class="btn btn-primary" @onclick="StartCreate">New customer</button>
</div>

@if (_message is not null)
{
    <div class="alert alert-success">@_message</div>
}

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<section class="content-grid customer-management-grid">
    <article class="card-panel customer-form-panel">
        <div class="section-title">
            <div>
                <p class="eyebrow">@(_isEditMode ? "Edit" : "Create")</p>
                <h2>@(_isEditMode ? "Edit customer" : "Create customer")</h2>
            </div>
            @if (_isEditMode)
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="StartCreate">Cancel edit</button>
            }
        </div>

        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-grid">
                <div class="form-field">
                    <label>Customer number</label>
                    <InputText class="form-control" @bind-Value="_form.CustomerNumber" disabled="@_isEditMode" />
                    <small>Format: CU00001</small>
                </div>

                <div class="form-field">
                    <label>Email</label>
                    <InputText class="form-control" @bind-Value="_form.Email" />
                </div>

                <div class="form-field">
                    <label>Last name</label>
                    <InputText class="form-control" @bind-Value="_form.LastName" />
                </div>

                <div class="form-field">
                    <label>Surname</label>
                    <InputText class="form-control" @bind-Value="_form.SurName" />
                </div>

                <div class="form-field form-field-wide">
                    <label>Website</label>
                    <InputText class="form-control" @bind-Value="_form.Website" />
                    <small>Allowed: google.com, www.google.com, https://policies.google.com/path?x=y</small>
                </div>
            </div>

            <hr />

            <div class="section-title compact">
                <div>
                    <p class="eyebrow">Initial/current address</p>
                    <h2>@(_isEditMode ? "Change current address" : "Initial address")</h2>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-field">
                    <label>Valid from</label>
                    <InputDate class="form-control" @bind-Value="_form.AddressValidFrom" />
                </div>

                <div class="form-field">
                    <label>Street</label>
                    <InputText class="form-control" @bind-Value="_form.Street" />
                </div>

                <div class="form-field">
                    <label>House number</label>
                    <InputText class="form-control" @bind-Value="_form.HouseNumber" />
                </div>

                <div class="form-field">
                    <label>Postal code</label>
                    <InputText class="form-control" @bind-Value="_form.PostalCode" />
                </div>

                <div class="form-field">
                    <label>City</label>
                    <InputText class="form-control" @bind-Value="_form.City" />
                </div>

                <div class="form-field">
                    <label>Country code</label>
                    <InputText class="form-control" @bind-Value="_form.CountryCode" />
                </div>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" type="submit" disabled="@_isBusy">
                    @(_isBusy ? "Saving..." : _isEditMode ? "Save changes" : "Create customer")
                </button>
            </div>
        </EditForm>
    </article>

    <article class="card-panel customer-list-panel">
        <div class="section-title">
            <div>
                <p class="eyebrow">Overview</p>
                <h2>Customer list</h2>
            </div>
        </div>

        <div class="search-row">
            <InputText class="form-control" placeholder="Search by name, number or email" @bind-Value="_searchTerm" />
            <button class="btn btn-outline-primary" @onclick="LoadCustomersAsync" disabled="@_isBusy">Search</button>
        </div>

        @if (_customers.Count == 0)
        {
            <div class="empty-state">
                <strong>No customers found.</strong>
                <span>Create the first customer or adjust the search.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table customer-table align-middle">
                    <thead>
                        <tr>
                            <th>Number</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Current address</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CustomerListItemDto customer in _customers)
                        {
                            <tr class="customer-row @(_selectedCustomer?.CustomerId == customer.CustomerId ? "selected" : null)" @onclick="() => LoadDetailsAsync(customer.CustomerId)">
                                <td><span class="badge-soft">@customer.CustomerNumber</span></td>
                                <td>@customer.FullName</td>
                                <td>@customer.Email</td>
                                <td>@customer.Street @customer.HouseNumber, @customer.PostalCode @customer.City</td>
                                <td class="table-actions">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadForEditAsync(customer.CustomerId)" @onclick:stopPropagation="true">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(customer.CustomerId)" @onclick:stopPropagation="true">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>

    <aside class="card-panel customer-detail-panel">
        @if (_selectedCustomer is null)
        {
            <div class="empty-state detail-empty-state">
                <strong>No customer selected.</strong>
                <span>Click a customer row to open details and manage addresses.</span>
            </div>
        }
        else
        {
            <div class="section-title">
                <div>
                    <p class="eyebrow">Details</p>
                    <h2>@_selectedCustomer.FullName</h2>
                    <p class="page-subtitle mb-0">@_selectedCustomer.CustomerNumber · @_selectedCustomer.Email</p>
                </div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CloseDetails">Close</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_selectedCustomer.Website))
            {
                <p><strong>Website:</strong> @_selectedCustomer.Website</p>
            }

            <section class="address-block current-address-block">
                <div class="address-block-header">
                    <span class="status-pill current">Current</span>
                    <strong>Actual address</strong>
                </div>
                @if (_selectedCustomer.CurrentAddress is null)
                {
                    <p class="text-muted">No current address exists.</p>
                }
                else
                {
                    @RenderAddress(_selectedCustomer.CurrentAddress)
                }
            </section>

            <section class="address-block">
                <div class="address-block-header">
                    <span class="status-pill future">New</span>
                    <strong>Add future/current address</strong>
                </div>

                <EditForm Model="_addressForm" OnValidSubmit="AddAddressAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-grid address-form-grid">
                        <div class="form-field">
                            <label>Valid from</label>
                            <InputDate class="form-control" @bind-Value="_addressForm.ValidFrom" />
                        </div>
                        <div class="form-field">
                            <label>Street</label>
                            <InputText class="form-control" @bind-Value="_addressForm.Street" />
                        </div>
                        <div class="form-field">
                            <label>House number</label>
                            <InputText class="form-control" @bind-Value="_addressForm.HouseNumber" />
                        </div>
                        <div class="form-field">
                            <label>Postal code</label>
                            <InputText class="form-control" @bind-Value="_addressForm.PostalCode" />
                        </div>
                        <div class="form-field">
                            <label>City</label>
                            <InputText class="form-control" @bind-Value="_addressForm.City" />
                        </div>
                        <div class="form-field">
                            <label>Country code</label>
                            <InputText class="form-control" @bind-Value="_addressForm.CountryCode" />
                        </div>
                    </div>

                    <div class="form-actions">
                        <button class="btn btn-primary" type="submit" disabled="@_isBusy">Add address</button>
                    </div>
                </EditForm>
            </section>

            <section class="address-block">
                <div class="address-block-header">
                    <span class="status-pill future">Future</span>
                    <strong>Future addresses</strong>
                </div>
                @if (_selectedCustomer.FutureAddresses.Count == 0)
                {
                    <p class="text-muted">No future addresses scheduled.</p>
                }
                else
                {
                    @foreach (CustomerAddressDto address in _selectedCustomer.FutureAddresses)
                    {
                        @RenderAddress(address)
                    }
                }
            </section>

            <section class="address-block">
                <div class="address-block-header">
                    <span class="status-pill previous">History</span>
                    <strong>Previous addresses</strong>
                </div>
                @if (_selectedCustomer.PreviousAddresses.Count == 0)
                {
                    <p class="text-muted">No previous addresses.</p>
                }
                else
                {
                    @foreach (CustomerAddressDto address in _selectedCustomer.PreviousAddresses)
                    {
                        @RenderAddress(address)
                    }
                }
            </section>
        }
    </aside>
</section>

@code {
    private readonly CustomerFormModel _form = new();
    private readonly CustomerAddressFormModel _addressForm = new();
    private readonly List<CustomerListItemDto> _customers = [];

    private GetCustomerDetailsResponse? _selectedCustomer;
    private string? _searchTerm;
    private string? _message;
    private string? _error;
    private bool _isBusy;
    private bool _isEditMode;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomersAsync();
    }

    private void StartCreate()
    {
        _isEditMode = false;
        _message = null;
        _error = null;
        _form.Reset();
    }

    private async Task LoadCustomersAsync()
    {
        _isBusy = true;
        _error = null;

        var result = await SearchCustomersUseCase.ExecuteAsync(new SearchCustomersQuery(_searchTerm));

        _customers.Clear();

        if (!result.IsSuccess)
        {
            _error = result.Error;
            _isBusy = false;
            return;
        }

        _customers.AddRange(result.Value!);
        _isBusy = false;
    }

    private async Task LoadDetailsAsync(int customerId)
    {
        _isBusy = true;
        _error = null;

        var result = await GetCustomerDetailsUseCase.ExecuteAsync(new GetCustomerDetailsQuery(customerId));

        if (!result.IsSuccess)
        {
            _error = result.Error;
            _isBusy = false;
            return;
        }

        _selectedCustomer = result.Value!;
        _addressForm.Reset();
        _isBusy = false;
    }

    private void CloseDetails()
    {
        _selectedCustomer = null;
        _addressForm.Reset();
    }

    private async Task SaveAsync()
    {
        _isBusy = true;
        _message = null;
        _error = null;

        if (_isEditMode)
        {
            var command = new UpdateCustomerCommand(
                _form.CustomerId,
                _form.LastName,
                _form.SurName,
                _form.Email,
                _form.Website,
                DateOnly.FromDateTime(_form.AddressValidFrom),
                _form.Street,
                _form.HouseNumber,
                _form.PostalCode,
                _form.City,
                _form.CountryCode);

            var result = await UpdateCustomerUseCase.ExecuteAsync(command);

            if (!result.IsSuccess)
            {
                _error = result.Error;
                _isBusy = false;
                return;
            }

            _message = "Customer was updated.";
            if (_selectedCustomer?.CustomerId == _form.CustomerId)
            {
                await LoadDetailsAsync(_form.CustomerId);
            }
        }
        else
        {
            var command = new CreateCustomerCommand(
                _form.CustomerNumber,
                _form.LastName,
                _form.SurName,
                _form.Email,
                _form.Website,
                DateOnly.FromDateTime(_form.AddressValidFrom),
                _form.Street,
                _form.HouseNumber,
                _form.PostalCode,
                _form.City,
                _form.CountryCode);

            var result = await CreateCustomerUseCase.ExecuteAsync(command);

            if (!result.IsSuccess)
            {
                _error = result.Error;
                _isBusy = false;
                return;
            }

            _message = $"Customer {result.Value!.CustomerNumber} was created.";
            _form.Reset();
        }

        await LoadCustomersAsync();
        _isBusy = false;
    }

    private async Task LoadForEditAsync(int customerId)
    {
        _isBusy = true;
        _message = null;
        _error = null;

        var result = await GetCustomerForEditUseCase.ExecuteAsync(new GetCustomerForEditQuery(customerId));

        if (!result.IsSuccess)
        {
            _error = result.Error;
            _isBusy = false;
            return;
        }

        GetCustomerForEditResponse customer = result.Value!;

        _form.CustomerId = customer.CustomerId;
        _form.CustomerNumber = customer.CustomerNumber;
        _form.LastName = customer.LastName;
        _form.SurName = customer.SurName;
        _form.Email = customer.Email;
        _form.Website = customer.Website;
        _form.AddressValidFrom = customer.AddressValidFrom.ToDateTime(TimeOnly.MinValue);
        _form.Street = customer.Street;
        _form.HouseNumber = customer.HouseNumber;
        _form.PostalCode = customer.PostalCode;
        _form.City = customer.City;
        _form.CountryCode = customer.CountryCode;

        _isEditMode = true;
        _isBusy = false;

        await LoadDetailsAsync(customerId);
    }

    private async Task AddAddressAsync()
    {
        if (_selectedCustomer is null)
        {
            return;
        }

        _isBusy = true;
        _message = null;
        _error = null;

        var command = new AddCustomerAddressCommand(
            _selectedCustomer.CustomerId,
            DateOnly.FromDateTime(_addressForm.ValidFrom),
            _addressForm.Street,
            _addressForm.HouseNumber,
            _addressForm.PostalCode,
            _addressForm.City,
            _addressForm.CountryCode);

        var result = await AddCustomerAddressUseCase.ExecuteAsync(command);

        if (!result.IsSuccess)
        {
            _error = result.Error;
            _isBusy = false;
            return;
        }

        int customerId = _selectedCustomer.CustomerId;
        _message = "Address was added.";
        _addressForm.Reset();

        await LoadCustomersAsync();
        await LoadDetailsAsync(customerId);
        _isBusy = false;
    }

    private async Task DeleteAsync(int customerId)
    {
        _isBusy = true;
        _message = null;
        _error = null;

        var result = await DeleteCustomerUseCase.ExecuteAsync(new DeleteCustomerCommand(customerId));

        if (!result.IsSuccess)
        {
            _error = result.Error;
            _isBusy = false;
            return;
        }

        if (_selectedCustomer?.CustomerId == customerId)
        {
            _selectedCustomer = null;
        }

        _message = "Customer was deleted.";
        await LoadCustomersAsync();
        _isBusy = false;
    }

    private static RenderFragment RenderAddress(CustomerAddressDto address) => builder =>
    {
        int sequence = 0;
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "address-card");
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "address-card-main");
        builder.OpenElement(sequence++, "strong");
        builder.AddContent(sequence++, $"{address.Street} {address.HouseNumber}");
        builder.CloseElement();
        builder.OpenElement(sequence++, "span");
        builder.AddContent(sequence++, $"{address.PostalCode} {address.City}, {address.CountryCode}");
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(sequence++, "small");
        string validTo = address.ValidTo is null ? "open" : address.ValidTo.Value.ToString("yyyy-MM-dd");
        builder.AddContent(sequence++, $"Valid {address.ValidFrom:yyyy-MM-dd} – {validTo}");
        builder.CloseElement();
        builder.CloseElement();
    };

    private sealed class CustomerFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.RegularExpression(@"^CU\d{5}$", ErrorMessage = "Customer number must match CU00001.")]
        public string CustomerNumber { get; set; } = "CU00001";

        public int CustomerId { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string LastName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string SurName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        public string? Website { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public DateTime AddressValidFrom { get; set; } = DateTime.Today;

        [System.ComponentModel.DataAnnotations.Required]
        public string Street { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string HouseNumber { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string PostalCode { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string City { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(2, MinimumLength = 2)]
        public string CountryCode { get; set; } = "CH";

        public void Reset()
        {
            CustomerId = 0;
            CustomerNumber = "CU00001";
            LastName = string.Empty;
            SurName = string.Empty;
            Email = string.Empty;
            Website = null;
            AddressValidFrom = DateTime.Today;
            Street = string.Empty;
            HouseNumber = string.Empty;
            PostalCode = string.Empty;
            City = string.Empty;
            CountryCode = "CH";
        }
    }

    private sealed class CustomerAddressFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public DateTime ValidFrom { get; set; } = DateTime.Today.AddDays(1);

        [System.ComponentModel.DataAnnotations.Required]
        public string Street { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string HouseNumber { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string PostalCode { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string City { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(2, MinimumLength = 2)]
        public string CountryCode { get; set; } = "CH";

        public void Reset()
        {
            ValidFrom = DateTime.Today.AddDays(1);
            Street = string.Empty;
            HouseNumber = string.Empty;
            PostalCode = string.Empty;
            City = string.Empty;
            CountryCode = "CH";
        }
    }
}
