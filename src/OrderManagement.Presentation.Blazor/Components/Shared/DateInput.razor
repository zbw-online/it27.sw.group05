@namespace OrderManagement.Presentation.Blazor.Components.Shared
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@using System.Globalization

<div class="date-input">
    <input type="text"
           id="@Id"
           class="date-input-text form-control"
           placeholder="TT.MM.JJJJ"
           value="@DisplayValue"
           @onchange="OnTextChangedAsync" />
    <button type="button" class="date-input-icon" aria-label="Datum auswählen" @onclick="OpenPickerAsync">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="2" y="3" width="12" height="11" rx="1.5" stroke="currentColor" stroke-width="1.3" />
            <path d="M2 6.5h12M5 1.5v2.5M11 1.5v2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
    </button>
    <input type="date"
           @ref="_nativeRef"
           class="date-input-native"
           tabindex="-1"
           aria-hidden="true"
           value="@NativeValue"
           @onchange="OnNativeChangedAsync" />
</div>

@code {
    private static readonly CultureInfo SwissCulture = CultureInfo.GetCultureInfo("de-CH");

    private ElementReference _nativeRef;
    private IJSObjectReference? _module;

    [Parameter] public string? Id { get; set; }
    [Parameter] public DateTime Value { get; set; }
    [Parameter] public EventCallback<DateTime> ValueChanged { get; set; }

    private string DisplayValue => Value.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture);

    private string NativeValue => Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private async Task OnTextChangedAsync(ChangeEventArgs e)
    {
        if (DateTime.TryParseExact(e.Value?.ToString(), "dd.MM.yyyy", SwissCulture, DateTimeStyles.None, out DateTime parsed))
        {
            await ValueChanged.InvokeAsync(parsed);
        }
    }

    private async Task OnNativeChangedAsync(ChangeEventArgs e)
    {
        if (DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime parsed))
        {
            await ValueChanged.InvokeAsync(parsed);
        }
    }

    private async Task OpenPickerAsync()
    {
        _module ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/dateInput.js");
        await _module.InvokeVoidAsync("openPicker", _nativeRef);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
}
