@namespace OrderManagement.Presentation.Blazor.Components.Shared
@using OrderManagement.Application.Features.Catalog.Contracts
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div class="category-flyout" @ref="_containerRef" @onkeydown="OnRootKeyDownAsync">
    <div class="category-flyout-control">
        <button type="button"
                class="category-flyout-trigger"
                @ref="_triggerRef"
                aria-haspopup="@(IsInline ? "false" : "menu")"
                aria-expanded="@(_isOpen ? "true" : "false")"
                aria-controls="@_menuId"
                @onclick="ToggleOpenAsync"
                @onkeydown="OnTriggerKeyDownAsync">
            @if (!string.IsNullOrEmpty(Label))
            {
                <span class="category-flyout-label">@Label</span>
            }
            <span class="category-flyout-value" title="@ClosedValueText">@ClosedValueText</span>
            <span class="category-flyout-chevron @(_isOpen ? "is-open" : string.Empty)" aria-hidden="true">&#9662;</span>
        </button>
        @if (SelectedGroupId.HasValue)
        {
            <button type="button" class="category-flyout-clear" aria-label="Kategoriefilter zurücksetzen" @onclick="ClearSelectionAsync">
                <span aria-hidden="true">&times;</span>
            </button>
        }
    </div>

    @if (_isOpen)
    {
        <div class="category-flyout-panels @(IsInline ? "is-inline" : string.Empty)" id="@_menuId" @ref="_panelsRef">
            @if (IsLoading)
            {
                <div class="category-flyout-status">
                    <LoadingState Text="Kategorien werden geladen …" />
                </div>
            }
            else if (Hierarchy.Count == 0)
            {
                <div class="category-flyout-status">
                    <EmptyState Title="Keine Kategorien vorhanden" Description="Es sind noch keine Kategorien angelegt." />
                </div>
            }
            else if (EffectiveCompact)
            {
                <div class="category-flyout-drilldown" role="@(IsInline ? null : "dialog")" aria-label="@(IsInline ? null : "Kategorie auswählen")">
                    <div class="category-flyout-breadcrumb-bar">
                        @if (_expandedPath.Count > 0)
                        {
                            <button type="button" class="category-flyout-back" @onclick="() => CollapseOneLevelAsync(_expandedPath.Count)">
                                &#8592; Zurück
                            </button>
                        }
                        <span class="category-flyout-drilldown-breadcrumb">@DrilldownBreadcrumb()</span>
                    </div>
                    <CategoryFlyoutPanel Level="_expandedPath.Count"
                                         Items="ItemsForLevel(_expandedPath.Count)"
                                         SelectedId="SelectedGroupId"
                                         FocusedIndex="_focusedIndex"
                                         IsFocusedLevel="_focusedLevel == _expandedPath.Count"
                                         AriaLabel="@LevelLabel(_expandedPath.Count)"
                                         OnActivate="item => ActivateAsync(_expandedPath.Count, item)"
                                         OnKeyDown="OnItemKeyDownAsync" />
                </div>
            }
            else
            {
                @for (int level = 0; level <= _expandedPath.Count; level++)
                {
                    int currentLevel = level;
                    <div class="category-flyout-panel-wrapper">
                        <CategoryFlyoutPanel Level="currentLevel"
                                             Items="ItemsForLevel(currentLevel)"
                                             SelectedId="SelectedGroupId"
                                             FocusedIndex="_focusedIndex"
                                             IsFocusedLevel="_focusedLevel == currentLevel"
                                             AriaLabel="@LevelLabel(currentLevel)"
                                             OnActivate="item => ActivateAsync(currentLevel, item)"
                                             OnKeyDown="OnItemKeyDownAsync" />
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private static readonly string[] LevelLabels = ["Hauptgruppen", "Untergruppen", "Kategorien"];

    private readonly string _menuId = $"category-flyout-menu-{Guid.NewGuid():N}";

    private List<int> _expandedPath = [];
    private HashSet<int> _parentIds = [];
    private IReadOnlyList<ArticleGroupHierarchyDto> _lastHierarchy = [];

    private bool _isOpen;
    private bool _isCompact;
    private bool _pendingFocusMove;
    private bool _repositionRegistered;
    private int _focusedLevel;
    private int _focusedIndex = -1;

    private ElementReference _containerRef;
    private ElementReference _triggerRef;
    private ElementReference _panelsRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CategoryCascadeSelector>? _selfRef;

    [Parameter] public string Label { get; set; } = "Kategorie";
    [Parameter, EditorRequired] public IReadOnlyList<ArticleGroupHierarchyDto> Hierarchy { get; set; } = [];
    [Parameter] public int? SelectedGroupId { get; set; }
    [Parameter] public EventCallback<int?> SelectedGroupIdChanged { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public CategorySelectorMode Mode { get; set; } = CategorySelectorMode.Auto;

    private bool IsInline => Mode == CategorySelectorMode.InlineDrilldown;
    private bool EffectiveCompact => IsInline || _isCompact;

    private string ClosedValueText => SelectedGroupId.HasValue
        ? Hierarchy.FirstOrDefault(g => g.Id == SelectedGroupId.Value)?.Path ?? "Alle Kategorien"
        : "Alle Kategorien";

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastHierarchy, Hierarchy))
        {
            _lastHierarchy = Hierarchy;
            _parentIds = [.. Hierarchy.Where(g => g.ParentGroupId.HasValue).Select(g => g.ParentGroupId!.Value)];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isOpen || _module is null)
        {
            return;
        }

        if (_pendingFocusMove)
        {
            _pendingFocusMove = false;
            await _module.InvokeVoidAsync("focusItem", _panelsRef, _focusedLevel, _focusedIndex);
        }

        if (IsInline)
        {
            return;
        }

        bool compact = await _module.InvokeAsync<bool>("applyPlacement", _triggerRef, _panelsRef, _expandedPath.Count);

        if (!_repositionRegistered)
        {
            _repositionRegistered = true;
            await _module.InvokeVoidAsync("registerReposition", _triggerRef, _panelsRef, _selfRef);
        }

        if (compact != _isCompact)
        {
            _isCompact = compact;
            StateHasChanged();
        }
    }

    private IReadOnlyList<CategoryFlyoutItem> ItemsForLevel(int level)
    {
        IEnumerable<ArticleGroupHierarchyDto> source = level == 0
            ? Hierarchy.Where(g => g.ParentGroupId is null)
            : level <= _expandedPath.Count
                ? Hierarchy.Where(g => g.ParentGroupId == _expandedPath[level - 1])
                : [];

        List<CategoryFlyoutItem> items = [.. source
            .OrderBy(g => g.Name)
            .Select(g => new CategoryFlyoutItem(g.Id, g.Name, _parentIds.Contains(g.Id)))];

        if (level == 0)
        {
            items.Insert(0, new CategoryFlyoutItem(null, "Alle Kategorien", false));
        }

        return items;
    }

    private static string LevelLabel(int level) =>
        level < LevelLabels.Length ? LevelLabels[level] : $"Ebene {level + 1}";

    private string DrilldownBreadcrumb()
    {
        if (_expandedPath.Count == 0)
        {
            return "Alle Kategorien";
        }

        return string.Join(" › ", _expandedPath.Select(id => Hierarchy.FirstOrDefault(g => g.Id == id)?.Name ?? string.Empty));
    }

    private async Task ToggleOpenAsync()
    {
        if (_isOpen)
        {
            await CloseAsync(restoreFocus: false);
        }
        else
        {
            await OpenAsync();
        }
    }

    private async Task OnTriggerKeyDownAsync(KeyboardEventArgs e)
    {
        // Enter and Space are deliberately not handled here: a focused <button> already
        // triggers a native click for those keys, which OnClick/ToggleOpenAsync handles.
        // Opening here too would race the synthetic click and immediately close the menu again.
        if (_isOpen || e.Key != "ArrowDown")
        {
            return;
        }

        await OpenAsync();
    }

    private async Task OnRootKeyDownAsync(KeyboardEventArgs e)
    {
        if (_isOpen && e.Key == "Escape")
        {
            await CloseAsync(restoreFocus: true);
        }
    }

    private async Task OpenAsync()
    {
        _module ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/categoryFlyout.js");
        _selfRef ??= DotNetObjectReference.Create(this);

        _expandedPath = BuildAncestorChain(SelectedGroupId);
        _focusedLevel = _expandedPath.Count;
        _focusedIndex = Math.Max(0, ItemsForLevel(_focusedLevel).ToList().FindIndex(i => i.Id == SelectedGroupId));
        _isOpen = true;

        if (!IsInline)
        {
            await _module.InvokeVoidAsync("registerOutsideClick", _containerRef, _selfRef);
        }

        _pendingFocusMove = true;
    }

    private async Task CloseAsync(bool restoreFocus)
    {
        _isOpen = false;
        _isCompact = false;
        _repositionRegistered = false;

        if (_module is not null && !IsInline)
        {
            await _module.InvokeVoidAsync("unregisterOutsideClick");
            await _module.InvokeVoidAsync("unregisterReposition");
        }

        if (restoreFocus)
        {
            await _triggerRef.FocusAsync();
        }
    }

    [JSInvokable]
    public async Task OnOutsideClickAsync()
    {
        if (_isOpen)
        {
            await CloseAsync(restoreFocus: false);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnCompactChangedAsync(bool compact)
    {
        if (compact != _isCompact)
        {
            _isCompact = compact;
            StateHasChanged();
        }
    }

    private List<int> BuildAncestorChain(int? selectedId)
    {
        var ancestors = new List<int>();
        if (!selectedId.HasValue)
        {
            return ancestors;
        }

        ArticleGroupHierarchyDto? node = Hierarchy.FirstOrDefault(g => g.Id == selectedId.Value);
        int? parentId = node?.ParentGroupId;

        while (parentId.HasValue)
        {
            ancestors.Insert(0, parentId.Value);
            ArticleGroupHierarchyDto? parent = Hierarchy.FirstOrDefault(g => g.Id == parentId.Value);
            parentId = parent?.ParentGroupId;
        }

        return ancestors;
    }

    private async Task ActivateAsync(int level, CategoryFlyoutItem item)
    {
        if (item.HasChildren)
        {
            ExpandLevel(level, item.Id!.Value);
            _pendingFocusMove = true;
        }
        else
        {
            await CommitSelectionAsync(item.Id);
        }
    }

    private void ExpandLevel(int level, int groupId)
    {
        _expandedPath = [.. _expandedPath.Take(level), groupId];
    }

    private async Task CommitSelectionAsync(int? groupId)
    {
        SelectedGroupId = groupId;
        await SelectedGroupIdChanged.InvokeAsync(groupId);
        await CloseAsync(restoreFocus: true);
    }

    private async Task ClearSelectionAsync() => await CommitSelectionAsync(null);

    private async Task CollapseOneLevelAsync(int level)
    {
        if (level == 0)
        {
            return;
        }

        int parentId = _expandedPath[level - 1];
        _expandedPath = [.. _expandedPath.Take(level - 1)];
        _focusedLevel = level - 1;
        _focusedIndex = Math.Max(0, ItemsForLevel(_focusedLevel).ToList().FindIndex(i => i.Id == parentId));
        _pendingFocusMove = true;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private void MoveFocus(int level, int delta)
    {
        IReadOnlyList<CategoryFlyoutItem> items = ItemsForLevel(level);
        if (items.Count == 0)
        {
            return;
        }

        int newIndex = Math.Clamp(_focusedIndex + delta, 0, items.Count - 1);
        _focusedLevel = level;
        _focusedIndex = newIndex;

        CategoryFlyoutItem focused = items[newIndex];
        _expandedPath = focused.HasChildren
            ? [.. _expandedPath.Take(level), focused.Id!.Value]
            : [.. _expandedPath.Take(level)];

        _pendingFocusMove = true;
    }

    private async Task OnItemKeyDownAsync(CategoryFlyoutKeyEvent keyEvent)
    {
        // Enter and Space are deliberately not handled here: a focused <button> already
        // triggers a native click for those keys, which OnActivate/ActivateAsync handles.
        // Activating here too would race the synthetic click and double-invoke selection.
        switch (keyEvent.Args.Key)
        {
            case "ArrowRight":
                if (keyEvent.Item.HasChildren)
                {
                    ExpandLevel(keyEvent.Level, keyEvent.Item.Id!.Value);
                    _focusedLevel = keyEvent.Level + 1;
                    _focusedIndex = 0;
                    _pendingFocusMove = true;
                }
                break;
            case "ArrowLeft":
                await CollapseOneLevelAsync(keyEvent.Level);
                break;
            case "ArrowDown":
                MoveFocus(keyEvent.Level, 1);
                break;
            case "ArrowUp":
                MoveFocus(keyEvent.Level, -1);
                break;
            default:
                return;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            if (!IsInline)
            {
                await _module.InvokeVoidAsync("unregisterOutsideClick");
                await _module.InvokeVoidAsync("unregisterReposition");
            }

            await _module.DisposeAsync();
        }

        _selfRef?.Dispose();
    }
}
