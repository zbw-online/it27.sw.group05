@namespace OrderManagement.Presentation.Blazor.Components.Shared

<nav class="pagination" aria-label="Seitennavigation">
    <button type="button" class="pagination-arrow pagination-prev" aria-label="Vorherige Seite" disabled="@(CurrentPage <= 1)" @onclick="() => OnPageChange.InvokeAsync(CurrentPage - 1)">
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5.5 8l4.5 5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>

    @foreach (int? item in PageItems())
    {
        @if (item is int page)
        {
            <button type="button"
                    class="pagination-page @(page == CurrentPage ? "is-active" : string.Empty)"
                    aria-current="@(page == CurrentPage ? "page" : null)"
                    @onclick="() => OnPageChange.InvokeAsync(page)">
                @(page)
            </button>
        }
        else
        {
            <span class="pagination-ellipsis" aria-hidden="true">…</span>
        }
    }

    <button type="button" class="pagination-arrow pagination-next" aria-label="Nächste Seite" disabled="@(CurrentPage >= TotalPages)" @onclick="() => OnPageChange.InvokeAsync(CurrentPage + 1)">
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l4.5 5L6 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
</nav>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public EventCallback<int> OnPageChange { get; set; }

    private IEnumerable<int?> PageItems()
    {
        SortedSet<int> shown = [1, Math.Min(2, TotalPages), Math.Min(3, TotalPages), TotalPages,
            Math.Max(1, CurrentPage - 1), CurrentPage, Math.Min(TotalPages, CurrentPage + 1)];

        int? previous = null;
        foreach (int page in shown)
        {
            if (previous is not null && page - previous > 1)
            {
                yield return null;
            }

            yield return page;
            previous = page;
        }
    }
}
