@implements IDisposable
@inject NavigationManager Navigation

<div class="nav-brand">
    <span class="nav-brand-mark" aria-hidden="true">M</span>
    <span class="nav-brand-text">MUSTER AG</span>
</div>

<nav class="nav-links" aria-label="Bereiche">
    @foreach ((string Href, string Label, string Icon) item in _items)
    {
        <a class="nav-link @(IsActive(item.Href) ? "is-active" : string.Empty)"
           href="@item.Href"
           aria-current="@(IsActive(item.Href) ? "page" : null)">
            <span class="nav-link-icon" aria-hidden="true">@((MarkupString)item.Icon)</span>
            <span>@item.Label</span>
        </a>
    }
</nav>

<nav class="nav-links nav-links-secondary" aria-label="Weitere Funktionen">
    @foreach ((string Href, string Label, string Icon) item in _secondaryItems)
    {
        <a class="nav-link @(IsActive(item.Href) ? "is-active" : string.Empty)"
           href="@item.Href"
           aria-current="@(IsActive(item.Href) ? "page" : null)">
            <span class="nav-link-icon" aria-hidden="true">@((MarkupString)item.Icon)</span>
            <span>@item.Label</span>
        </a>
    }
</nav>

<div class="nav-footer">
    <span class="nav-footer-app">Muster AG Auftragsverwaltung</span>
    <span class="nav-footer-version">v@_appVersion</span>
</div>

@code {
    private const string HomeIcon = "<svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M3 9.5 10 3l7 6.5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M5 8.5V17h10V8.5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>";
    private const string CustomersIcon = "<svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\"><circle cx=\"7.5\" cy=\"6.5\" r=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M2.5 17c0-3 2.2-5 5-5s5 2 5 5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><circle cx=\"14.5\" cy=\"7\" r=\"2\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M12.8 12.3c2.4.3 4.2 2.1 4.2 4.7\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg>";
    private const string ArticlesIcon = "<svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M3 6.2 10 3l7 3.2-7 3.2-7-3.2Z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/><path d=\"M3 6.2V14l7 3.2 7-3.2V6.2\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/><path d=\"M10 9.4v7.8\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg>";
    private const string OrdersIcon = "<svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M3 4h2l1.2 9.4A1.6 1.6 0 0 0 7.8 15h6.7a1.6 1.6 0 0 0 1.6-1.3L17 6.5H6.4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"8.3\" cy=\"17.3\" r=\"1\" fill=\"currentColor\"/><circle cx=\"14.3\" cy=\"17.3\" r=\"1\" fill=\"currentColor\"/></svg>";
    private const string ReportsIcon = "<svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M4 16.5V8.7M9.6 16.5V3.5M15.2 16.5v-6.8\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><path d=\"M3 16.5h14\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg>";
    private const string SettingsIcon = "<svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\"><circle cx=\"10\" cy=\"10\" r=\"2.6\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M10 3.2v1.8M10 15v1.8M16.8 10h-1.8M5 10H3.2M14.7 5.3l-1.3 1.3M6.6 13.3l-1.3 1.3M14.7 14.7l-1.3-1.3M6.6 6.6 5.3 5.3\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg>";
    private const string LogoutIcon = "<svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M8 17H4.8A1.8 1.8 0 0 1 3 15.2V4.8A1.8 1.8 0 0 1 4.8 3H8\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12.5 13.5 17 10l-4.5-3.5M17 10H8\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>";

    private readonly (string Href, string Label, string Icon)[] _items =
    [
        ("", "Übersicht", HomeIcon),
        ("kunden", "Kunden", CustomersIcon),
        ("artikel", "Artikel", ArticlesIcon),
        ("auftraege", "Aufträge", OrdersIcon)
    ];

    private readonly (string Href, string Label, string Icon)[] _secondaryItems =
    [
        ("berichte", "Berichte", ReportsIcon),
        ("einstellungen", "Einstellungen", SettingsIcon),
        ("abmelden", "Abmelden", LogoutIcon)
    ];

    private static readonly string _appVersion = typeof(NavMenu).Assembly.GetName().Version is { } version
        ? $"{version.Major}.{version.Minor}.{version.Build}"
        : "1.0.0";

    private string _currentPath = string.Empty;

    protected override void OnInitialized()
    {
        _currentPath = ToRelativePath(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentPath = ToRelativePath(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private static string ToRelativePath(string uri) => new Uri(uri).AbsolutePath.Trim('/').ToLowerInvariant();

    private bool IsActive(string href)
    {
        string target = href.Trim('/').ToLowerInvariant();
        return target.Length == 0
            ? _currentPath.Length == 0
            : _currentPath == target || _currentPath.StartsWith(target + "/", StringComparison.Ordinal);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
