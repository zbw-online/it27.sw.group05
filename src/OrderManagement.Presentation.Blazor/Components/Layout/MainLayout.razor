@inherits LayoutComponentBase
@inject IJSRuntime JsRuntime

<a href="#main-content" class="skip-link">Zum Inhalt springen</a>

<div class="app-shell" id="app-shell">
    <aside class="app-sidebar" aria-label="Hauptnavigation">
        <NavMenu />
    </aside>

    <div class="app-main">
        <main id="main-content" class="app-content" tabindex="-1">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" role="alert">
    Es ist ein unerwarteter Fehler aufgetreten.
    <a href="" class="reload">Neu laden</a>
    <a class="dismiss" aria-label="Meldung schliessen">🗙</a>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            IJSObjectReference module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/appReady.js");
            await module.InvokeVoidAsync("markInteractive");
        }
    }
}
