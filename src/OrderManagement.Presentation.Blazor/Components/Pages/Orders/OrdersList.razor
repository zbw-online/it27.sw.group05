@page "/auftraege"
@rendermode InteractiveServer
@using OrderManagement.Application.Features.Orders.DeleteOrder
@using OrderManagement.Application.Features.Orders.SearchOrders
@using OrderManagement.Application.Features.Orders.Shared
@using OrderManagement.Presentation.Blazor.Components.Shared
@inject ISearchOrdersUseCase SearchOrdersUseCase
@inject IDeleteOrderUseCase DeleteOrderUseCase
@inject NavigationManager Navigation

<PageTitle>Aufträge – Muster AG</PageTitle>

<PageHeader Title="Aufträge" Subtitle="@($"{_allOrders.Count} Aufträge")">
    <Actions>
        <Button Variant="ButtonVariant.Primary" OnClick="GoToNewOrder">+ Neuer Auftrag</Button>
    </Actions>
</PageHeader>

@if (_message is not null)
{
    <div class="inline-alert inline-alert-success" role="status">@_message</div>
}
@if (_error is not null)
{
    <div class="inline-alert inline-alert-danger" role="alert">@_error</div>
}

<div class="toolbar">
    <SearchField Label="Aufträge suchen" Placeholder="Auftrags-Nr. oder Kunden-Nr. suchen" @bind-Value="_searchTerm" OnSearch="LoadOrdersAsync" />
</div>

<article class="panel">
    @if (_isLoading)
    {
        <LoadingState Text="Aufträge werden geladen …" />
    }
    else if (_loadError is not null)
    {
        <ErrorState Title="Aufträge konnten nicht geladen werden" Description="@_loadError" OnRetry="LoadOrdersAsync" />
    }
    else if (_pagedOrders.Count == 0)
    {
        <EmptyState Title="Keine Aufträge gefunden" Description="Erstellen Sie den ersten Auftrag oder passen Sie die Suche an." />
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Auftrags-Nr.</th>
                        <th scope="col">Auftragsdatum</th>
                        <th scope="col">Kunde</th>
                        <th scope="col">Positionen</th>
                        <th scope="col">Auftragswert</th>
                        <th scope="col"><span class="visually-hidden">Aktionen</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (OrderListItemDto order in _pagedOrders)
                    {
                        <tr data-clickable="true" @onclick="() => GoToDetail(order.OrderId)">
                            <td class="numeric">@order.OrderNumber</td>
                            <td class="numeric">@Formatting.Date(order.OrderDate)</td>
                            <td class="numeric">@order.CustomerNumber</td>
                            <td class="numeric">@order.LineCount</td>
                            <td class="numeric">@Formatting.Chf(order.TotalAmount)</td>
                            <td class="table-actions">
                                <Button Variant="ButtonVariant.Danger" OnClick="() => RequestDelete(order.OrderId, order.OrderNumber)" AdditionalAttributes="StopPropagation">Löschen</Button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-bar">
            <FilterSelect Label="Zeilen pro Seite" Value="@_pageSize.ToString()" ValueChanged="OnPageSizeChanged">
                <option value="10">10</option>
                <option value="15">15</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </FilterSelect>
            <span class="pagination-summary numeric">@PaginationSummary()</span>
            <Pagination CurrentPage="_page" TotalPages="TotalPages" OnPageChange="ChangePage" />
        </div>
    }
</article>

<ConfirmDialog IsOpen="_isDeleteConfirmOpen"
               Title="Auftrag löschen"
               Message="@($"Soll der Auftrag „{_deleteTargetNumber}“ wirklich gelöscht werden? Dieser Vorgang kann nicht rückgängig gemacht werden.")"
               IsBusy="_isDeleting"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="() => _isDeleteConfirmOpen = false" />

@code {
    private static readonly Dictionary<string, object> StopPropagation = new() { { "onclick:stopPropagation", true } };

    private readonly List<OrderListItemDto> _allOrders = [];
    private string? _searchTerm;
    private bool _isLoading = true;
    private string? _loadError;
    private string? _message;
    private string? _error;

    private int _page = 1;
    private int _pageSize = 15;

    private bool _isDeleteConfirmOpen;
    private int _deleteTargetId;
    private string _deleteTargetNumber = string.Empty;
    private bool _isDeleting;

    private IReadOnlyList<OrderListItemDto> _pagedOrders =>
        [.. _allOrders.Skip((_page - 1) * _pageSize).Take(_pageSize)];

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_allOrders.Count / (double)_pageSize));

    protected override Task OnInitializedAsync() => LoadOrdersAsync();

    private async Task LoadOrdersAsync()
    {
        _isLoading = true;
        _loadError = null;

        var result = await SearchOrdersUseCase.ExecuteAsync(new SearchOrdersQuery(_searchTerm));

        _allOrders.Clear();
        if (!result.IsSuccess)
        {
            _loadError = result.Error;
            _isLoading = false;
            return;
        }

        _allOrders.AddRange(result.Value!);
        _page = 1;
        _isLoading = false;
    }

    private string PaginationSummary()
    {
        if (_allOrders.Count == 0)
        {
            return "0 von 0";
        }

        int from = (_page - 1) * _pageSize + 1;
        int to = Math.Min(_page * _pageSize, _allOrders.Count);
        return $"{from}–{to} von {_allOrders.Count}";
    }

    private void ChangePage(int page) => _page = Math.Clamp(page, 1, TotalPages);

    private Task OnPageSizeChanged(string? value)
    {
        _pageSize = int.TryParse(value, out int size) ? size : 15;
        _page = 1;
        return Task.CompletedTask;
    }

    private void GoToDetail(int orderId) => Navigation.NavigateTo($"auftraege/{orderId}");

    private void GoToNewOrder() => Navigation.NavigateTo("auftraege/neu");

    private void RequestDelete(int orderId, string orderNumber)
    {
        _deleteTargetId = orderId;
        _deleteTargetNumber = orderNumber;
        _isDeleteConfirmOpen = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        _isDeleting = true;
        _error = null;

        var result = await DeleteOrderUseCase.ExecuteAsync(new DeleteOrderCommand(_deleteTargetId));

        _isDeleting = false;
        _isDeleteConfirmOpen = false;

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        _message = "Auftrag wurde gelöscht.";
        await LoadOrdersAsync();
    }
}
